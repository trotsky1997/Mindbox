# Copy to `.env` and fill in. `.env` is gitignored; never commit secrets.
#
# Picked up automatically by `docker compose up` (env_file directive) and by
# the bare-metal `start.sh` if you `set -a; source .env; set +a` first.

# ---- Volcano Container Registry (image push) ------------------------------
# Used by:
#   ./template-builder/target/release/template-build --push <name>
#   ./scripts/backup-image-to-tos.sh
REGISTRY_HOST=image-mindverse-cn-beijing.cr.volces.com
REGISTRY_NAMESPACE=sandboxes
REGISTRY_USER=
REGISTRY_PASSWORD=
# Tag pattern: $REGISTRY_HOST/$REGISTRY_NAMESPACE/inspect-tpl-<name>:<version>
# e.g. image-mindverse-cn-beijing.cr.volces.com/sandboxes/inspect-tpl-default:latest

# ---- Volcano TOS / S3-compatible storage ----------------------------------
# Used by:
#   - e2b-shim sandbox snapshot endpoint
#   - backup scripts
#
# Endpoints (internal):  tos-cn-beijing.ivolces.com  /  tos-s3-cn-beijing.ivolces.com
# Endpoints (public):    tos-cn-beijing.volces.com   /  tos-s3-cn-beijing.volces.com
TOS_REGION=cn-beijing
TOS_BUCKET=
TOS_ENDPOINT=https://tos-cn-beijing.ivolces.com
TOS_S3_ENDPOINT=https://tos-s3-cn-beijing.ivolces.com
TOS_ACCESS_KEY=
TOS_SECRET_KEY=

# ---- tools container network -----------------------------------------------
# Applied by api-rust when starting template containers. Default bridge mode
# lets api-rust reach the tools-rust daemon through Docker's published port.
TOOLS_CONTAINER_NETWORK_MODE=bridge
