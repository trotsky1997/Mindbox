# Copy to `.env` and fill in. `.env` is gitignored; never commit secrets.
#
# Picked up automatically by `docker compose up` (env_file directive) and by
# the bare-metal `start.sh` if you `set -a; source .env; set +a` first.

# ---- Volcano Container Registry (image push) ------------------------------
# Used by:
#   ./template-builder/target/release/template-build --push <name>
#   ./scripts/backup-image-to-tos.sh
REGISTRY_HOST=image-mindverse-cn-beijing.cr.volces.com
REGISTRY_NAMESPACE=sandboxes
REGISTRY_USER=
REGISTRY_PASSWORD=
# Tag pattern: $REGISTRY_HOST/$REGISTRY_NAMESPACE/inspect-tpl-<name>:<version>
# e.g. image-mindverse-cn-beijing.cr.volces.com/sandboxes/inspect-tpl-default:latest

# ---- Volcano TOS / S3-compatible storage ----------------------------------
# Used by:
#   - worker-rust stdout/stderr offload (when WORKER_STDOUT_S3_THRESHOLD > 0)
#   - e2b-shim sandbox snapshot endpoint
#   - backup scripts
#
# Endpoints (internal):  tos-cn-beijing.ivolces.com  /  tos-s3-cn-beijing.ivolces.com
# Endpoints (public):    tos-cn-beijing.volces.com   /  tos-s3-cn-beijing.volces.com
TOS_REGION=cn-beijing
TOS_BUCKET=
TOS_ENDPOINT=https://tos-cn-beijing.ivolces.com
TOS_S3_ENDPOINT=https://tos-s3-cn-beijing.ivolces.com
TOS_ACCESS_KEY=
TOS_SECRET_KEY=

# ---- worker stdout/stderr offload (boto3 inside worker container) ---------
# When set, outputs larger than threshold are uploaded; the API response
# returns an s3:// URL instead of inline text.
WORKER_STDOUT_S3_THRESHOLD=0                     # bytes; 0 disables
WORKER_STDOUT_S3_BUCKET=
WORKER_STDOUT_S3_PREFIX=harbor/inspect-out/
# Reuses TOS_* above for the underlying S3 client:
#   endpoint_url = TOS_S3_ENDPOINT,  region = TOS_REGION
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY come from TOS_ACCESS_KEY / TOS_SECRET_KEY.

# ---- worker container network ---------------------------------------------
# Default "none" cuts off worker from the network (safe). To use TOS offload
# from inside the worker, you must allow it to reach the TOS endpoint:
#   WORKER_NETWORK_MODE=host       — easiest, full host network
#   WORKER_NETWORK_MODE=bridge     — docker default bridge (NAT)
WORKER_NETWORK_MODE=none
